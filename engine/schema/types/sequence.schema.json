{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.diagram-studio.local/types/sequence.schema.json",
  "title": "sequence body",
  "description": "Who talks to whom, in what order: participants as lifelines, messages as arrows between them, with fragments (loop, alt, opt, par), notes, phases and timing brackets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["participants", "steps"],
  "properties": {
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "../diagram.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": { "type": "string", "minLength": 1, "maxLength": 40 },
          "kind": { "enum": ["person", "system", "service", "database", "queue", "external"] },
          "icon": { "type": "string", "minLength": 1, "maxLength": 48 },
          "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" },
          "status": { "$ref": "../diagram.schema.json#/$defs/status" },
          "color": { "$ref": "#/$defs/color" }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "participants"],
        "properties": {
          "id": { "$ref": "../diagram.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "participants": { "type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": { "$ref": "../diagram.schema.json#/$defs/id" } },
          "color": { "$ref": "#/$defs/color" },
          "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" }
        }
      }
    },
    "steps": { "$ref": "#/$defs/steps", "minItems": 1 },
    "timings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label"],
        "properties": {
          "from": { "$ref": "../diagram.schema.json#/$defs/id" },
          "to": { "$ref": "../diagram.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 24 },
          "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" }
        }
      }
    },
    "numbering": { "enum": ["none", "badge", "inline"] },
    "activations": { "enum": ["auto", "manual", "none"] },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "participants": { "enum": ["card", "pill", "underline", "plain"] },
        "lifeline": { "enum": ["dashed", "dotted", "solid"] },
        "arrowheads": { "enum": ["classic", "filled", "open"] },
        "shading": { "enum": ["none", "soft", "banded"] },
        "density": { "enum": ["compact", "comfortable"] },
        "shadow": { "type": "boolean" },
        "mirror": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^(accent|highlight|muted|ink|cat-[1-8]|new|changed|retired|at-risk|#[0-9A-Fa-f]{6})$",
      "description": "A theme colour (accent, highlight, muted, ink), a categorical slot cat-1 … cat-8, a status colour (new, changed, retired, at-risk) or #RRGGBB."
    },
    "steps": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/step" }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/message" },
        { "$ref": "#/$defs/note" },
        { "$ref": "#/$defs/fragment" },
        { "$ref": "#/$defs/highlight" },
        { "$ref": "#/$defs/phase" },
        { "$ref": "#/$defs/divider" },
        { "$ref": "#/$defs/delay" }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": { "$ref": "../diagram.schema.json#/$defs/id" },
        "from": { "$ref": "../diagram.schema.json#/$defs/id" },
        "to": { "$ref": "../diagram.schema.json#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 60 },
        "kind": { "enum": ["sync", "async", "return", "fail"] },
        "style": { "enum": ["solid", "dashed", "dotted"] },
        "both": { "type": "boolean" },
        "activate": { "type": "boolean" },
        "deactivate": { "type": "boolean" },
        "create": { "type": "boolean" },
        "destroy": { "enum": ["from", "to"] },
        "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "over"],
      "properties": {
        "id": { "$ref": "../diagram.schema.json#/$defs/id" },
        "note": { "type": "string", "minLength": 1, "maxLength": 160 },
        "over": {
          "oneOf": [
            { "$ref": "../diagram.schema.json#/$defs/id" },
            { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "../diagram.schema.json#/$defs/id" } }
          ]
        },
        "position": { "enum": ["left", "right", "over"] },
        "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment", "steps"],
      "properties": {
        "id": { "$ref": "../diagram.schema.json#/$defs/id" },
        "fragment": { "enum": ["loop", "alt", "opt", "par", "critical", "break", "group"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "steps": { "$ref": "#/$defs/steps", "minItems": 1 },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["steps"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "steps": { "$ref": "#/$defs/steps", "minItems": 1 }
            }
          }
        },
        "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["highlight", "steps"],
      "properties": {
        "id": { "$ref": "../diagram.schema.json#/$defs/id" },
        "highlight": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 60 }, { "const": true }] },
        "steps": { "$ref": "#/$defs/steps", "minItems": 1 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "steps"],
      "properties": {
        "id": { "$ref": "../diagram.schema.json#/$defs/id" },
        "phase": { "type": "string", "minLength": 1, "maxLength": 30 },
        "steps": { "$ref": "#/$defs/steps", "minItems": 1 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["divider"],
      "properties": { "divider": { "type": "string", "minLength": 1, "maxLength": 60 } }
    },
    "delay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delay"],
      "properties": { "delay": { "type": "string", "minLength": 1, "maxLength": 60 } }
    }
  }
}
