{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.diagram-studio.local/types/layered-architecture.schema.json",
  "title": "layered-architecture body",
  "description": "System layers for a non-technical audience, with optional cross-cutting bars and external parties.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layers"],
  "properties": {
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "../diagram.schema.json#/$defs/layer" }
    },
    "crossCutting": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "../diagram.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 32 },
          "description": { "type": "string", "minLength": 1, "maxLength": 80 },
          "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" },
          "status": { "$ref": "../diagram.schema.json#/$defs/status" }
        }
      }
    },
    "external": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "../diagram.schema.json#/$defs/node" }
    },
    "externalLabel": { "$ref": "../diagram.schema.json#/$defs/shortText" }
  }
}
