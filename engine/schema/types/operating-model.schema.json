{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.diagram-studio.local/types/operating-model.schema.json",
  "title": "operating-model body",
  "description": "Layers of capability top-down: customers on top, foundations below, governance at the side.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layers"],
  "properties": {
    "customers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "items"],
      "properties": {
        "label": { "$ref": "../diagram.schema.json#/$defs/shortText" },
        "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "../diagram.schema.json#/$defs/shortText" } }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "../diagram.schema.json#/$defs/layer" }
    },
    "foundations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "../diagram.schema.json#/$defs/shortText" }
    },
    "foundationsLabel": { "$ref": "../diagram.schema.json#/$defs/shortText" },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "$ref": "../diagram.schema.json#/$defs/shortText" },
        "description": { "type": "string", "minLength": 1, "maxLength": 120 },
        "position": { "enum": ["left", "right"] },
        "items": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "../diagram.schema.json#/$defs/shortText" } }
      }
    }
  }
}
