{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.diagram-studio.local/types/narrative.schema.json",
  "title": "narrative body",
  "description": "A short block of text: a heading, paragraphs and bulleted points with optional bold lead-ins.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "heading": { "type": "string", "minLength": 1, "maxLength": 60 },
    "paragraphs": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "bullets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "lead": { "type": "string", "minLength": 1, "maxLength": 60 },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
