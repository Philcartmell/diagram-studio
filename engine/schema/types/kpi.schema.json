{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.diagram-studio.local/types/kpi.schema.json",
  "title": "kpi body",
  "description": "Big figures with a line of explanation each, in a row or a column. Figures print exactly as written.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "layout": { "enum": ["row", "column"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "label"],
        "properties": {
          "id": { "$ref": "../diagram.schema.json#/$defs/id" },
          "value": { "type": "string", "minLength": 1, "maxLength": 14 },
          "label": { "type": "string", "minLength": 1, "maxLength": 90 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 140 },
          "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" }
        }
      }
    }
  }
}
