{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.diagram-studio.local/types/roadmap.schema.json",
  "title": "roadmap body",
  "description": "Horizons over time as columns, workstreams as rows, items as bars, milestones and gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["horizons", "workstreams", "items"],
  "properties": {
    "scale": { "enum": ["equal", "time"] },
    "horizons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "../diagram.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 24 },
          "description": { "type": "string", "minLength": 1, "maxLength": 40 },
          "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
          "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" }
        }
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "../diagram.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 32 },
          "description": { "type": "string", "minLength": 1, "maxLength": 60 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 40 },
          "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "../diagram.schema.json#/$defs/nodeProps",
        "required": ["workstream", "start"],
        "properties": {
          "workstream": { "$ref": "../diagram.schema.json#/$defs/id" },
          "start": { "$ref": "../diagram.schema.json#/$defs/id" },
          "end": { "$ref": "../diagram.schema.json#/$defs/id" }
        },
        "unevaluatedProperties": false
      }
    },
    "milestones": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "horizon"],
        "properties": {
          "id": { "$ref": "../diagram.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "horizon": { "$ref": "../diagram.schema.json#/$defs/id" },
          "at": { "enum": ["start", "middle", "end"] },
          "kind": { "enum": ["milestone", "gate"] },
          "workstream": { "$ref": "../diagram.schema.json#/$defs/id" },
          "emphasis": { "$ref": "../diagram.schema.json#/$defs/emphasis" },
          "description": { "type": "string", "minLength": 1, "maxLength": 60 }
        }
      }
    }
  }
}
