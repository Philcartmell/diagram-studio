{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "virtualNetworks_vnet_spoke_name": { "defaultValue": "vnet-spoke", "type": "String" },
    "sites_app_contoso_name": { "defaultValue": "app-contoso", "type": "String" },
    "vaults_kv_contoso_name": { "defaultValue": "kv-contoso", "type": "String" },
    "servers_sql_contoso_name": { "defaultValue": "sql-contoso", "type": "String" },
    "location": { "defaultValue": "uksouth", "type": "String" }
  },
  "variables": {
    "agwName": "agw-contoso",
    "vmName": "vm-jumpbox"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "nsg-app",
      "location": "[parameters('location')]",
      "properties": { "securityRules": [] }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "pip-agw",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": { "publicIPAllocationMethod": "Static" }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[parameters('virtualNetworks_vnet_spoke_name')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": { "addressPrefixes": ["10.1.0.0/16"] },
        "subnets": [
          { "name": "snet-agw", "properties": { "addressPrefix": "10.1.0.0/24" } },
          {
            "name": "snet-app",
            "properties": {
              "addressPrefix": "10.1.1.0/24",
              "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-app')]" },
              "delegations": [{ "name": "web", "properties": { "serviceName": "Microsoft.Web/serverFarms" } }]
            }
          },
          {
            "name": "snet-pe",
            "properties": {
              "addressPrefix": "10.1.2.0/24",
              "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-app')]" }
            }
          },
          { "name": "snet-mgmt", "properties": { "addressPrefix": "10.1.3.0/24" } },
          { "name": "snet-unused", "properties": { "addressPrefix": "10.1.9.0/24" } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/applicationGateways",
      "apiVersion": "2023-09-01",
      "name": "[variables('agwName')]",
      "location": "[parameters('location')]",
      "properties": {
        "gatewayIPConfigurations": [
          { "name": "gwip", "properties": { "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_vnet_spoke_name'), 'snet-agw')]" } } }
        ],
        "frontendIPConfigurations": [
          { "name": "fe", "properties": { "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-agw')]" } } }
        ],
        "backendAddressPools": [
          { "name": "app", "properties": { "backendAddresses": [{ "fqdn": "[concat(parameters('sites_app_contoso_name'), '.azurewebsites.net')]" }] } }
        ]
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "asp-contoso",
      "location": "[parameters('location')]",
      "sku": { "name": "P1v3" },
      "properties": { "zoneRedundant": true }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('sites_app_contoso_name')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'asp-contoso')]",
        "virtualNetworkSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_vnet_spoke_name'), 'snet-app')]"
      },
      "resources": [
        { "type": "config", "apiVersion": "2023-01-01", "name": "web", "properties": { "alwaysOn": true } }
      ]
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "func-contoso",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "properties": { "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'asp-contoso')]" }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('vaults_kv_contoso_name')]",
      "location": "[parameters('location')]",
      "properties": { "tenantId": "00000000-0000-0000-0000-000000000000", "sku": { "family": "A", "name": "standard" } }
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-05-01-preview",
      "name": "[parameters('servers_sql_contoso_name')]",
      "location": "[parameters('location')]",
      "properties": { "administratorLogin": "sqladmin" },
      "resources": [
        { "type": "databases", "apiVersion": "2023-05-01-preview", "name": "sqldb-orders", "location": "[parameters('location')]", "properties": {} },
        { "type": "firewallRules", "apiVersion": "2023-05-01-preview", "name": "AllowAzure", "properties": {} }
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-05-01-preview",
      "name": "[concat(parameters('servers_sql_contoso_name'), '/master')]",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-09-01",
      "name": "pe-kv",
      "location": "[parameters('location')]",
      "properties": {
        "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_vnet_spoke_name'), 'snet-pe')]" },
        "privateLinkServiceConnections": [
          { "name": "kv", "properties": { "privateLinkServiceId": "[resourceId('Microsoft.KeyVault/vaults', parameters('vaults_kv_contoso_name'))]", "groupIds": ["vault"] } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-09-01",
      "name": "pe-sql",
      "location": "[parameters('location')]",
      "properties": {
        "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_vnet_spoke_name'), 'snet-pe')]" },
        "privateLinkServiceConnections": [
          { "name": "sql", "properties": { "privateLinkServiceId": "[resourceId('Microsoft.Sql/servers', parameters('servers_sql_contoso_name'))]", "groupIds": ["sqlServer"] } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '-nic')]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          { "name": "ipconfig1", "properties": { "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworks_vnet_spoke_name'), 'snet-mgmt')]" } } }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('vmName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkProfile": { "networkInterfaces": [{ "id": "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('vmName'), '-nic'))]" }] }
      }
    },
    {
      "type": "Microsoft.Compute/disks",
      "apiVersion": "2023-04-02",
      "name": "vm-jumpbox-osdisk",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "privatelink.vaultcore.azure.net",
      "location": "global",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "privatelink.database.windows.net",
      "location": "global",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "privatelink.vaultcore.azure.net/link-spoke",
      "location": "global",
      "properties": {
        "virtualNetwork": { "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworks_vnet_spoke_name'))]" },
        "registrationEnabled": false
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "log-contoso",
      "location": "[parameters('location')]",
      "properties": { "retentionInDays": 30 }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "appi-contoso",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": { "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', 'log-contoso')]" }
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "diag-agw",
      "properties": { "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', 'log-contoso')]" }
    },
    {
      "type": "Microsoft.Contoso/widgets",
      "apiVersion": "2024-01-01",
      "name": "widget-1",
      "location": "[parameters('location')]",
      "properties": {}
    }
  ]
}
