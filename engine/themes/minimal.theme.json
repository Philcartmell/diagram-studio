{
  "id": "minimal",
  "name": "Minimal",
  "description": "Mostly grey and line-led with a single accent. For reports and documents.",
  "extends": null,
  "color": {
    "background": "#FFFFFF",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F2F3F5",
    "ink": "#1F2328",
    "inkMuted": "#57606A",
    "line": "#C7CDD4",
    "lineStrong": "#4B5563",
    "accent": "#C2410C",
    "accentInk": "#FFFFFF",
    "highlight": "#4B5563",
    "categorical": ["#C2410C", "#4B5563", "#0E7490", "#9CA3AF", "#A16207", "#6D28D9"],
    "status": { "new": "#15803D", "changed": "#A16207", "retired": "#9CA3AF", "atRisk": "#B91C1C" }
  },
  "font": {
    "family": "Source Sans 3",
    "files": { "regular": "fonts/SourceSans3-Regular.ttf", "semibold": "fonts/SourceSans3-Semibold.ttf" },
    "size": { "title": 28, "subtitle": 16, "group": 15, "label": 14, "body": 12, "caption": 11 },
    "weight": { "title": 600, "label": 600, "body": 400 },
    "titleCase": "sentence",
    "lineHeight": 1.3
  },
  "shape": { "radius": 2, "stroke": 1, "strokeStrong": 1.75, "shadow": "none", "chevronDepth": 16 },
  "space": { "unit": 8, "gap": 16, "padding": 16, "margin": 48 },
  "connector": { "style": "orthogonal", "arrow": "open", "cornerRadius": 0 },
  "style": { "renderer": "clean", "showIcons": false, "accentFill": "tint", "headerRule": false, "bandFill": "none" }
}
